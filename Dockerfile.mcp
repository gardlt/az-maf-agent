FROM python:3.12.15-alpine3.24@sha256:1b668429b3511ab407d8e00648891631b0b1a4d7e15e3ca70f38ab5b91ad4ab4 AS base
RUN apk add --no-cache --upgrade zlib=1.3.2-r1

FROM base AS build
COPY --from=ghcr.io/astral-sh/uv:0.9.2@sha256:0178fbb205ada6c94ddbd45828f770a2d607cfa7c090276c69b8468a983da557 /uv /uvx /bin/
WORKDIR /build
ENV UV_PROJECT_ENVIRONMENT=/app/.venv
COPY pyproject.toml uv.lock ./
COPY apps/agent/pyproject.toml ./apps/agent/pyproject.toml
COPY apps/movie-catalog-mcp/pyproject.toml ./apps/movie-catalog-mcp/pyproject.toml
RUN uv sync --frozen --no-dev --package movie-catalog-mcp --no-install-package movie-catalog-mcp
COPY apps/movie-catalog-mcp/src ./apps/movie-catalog-mcp/src
RUN uv sync --frozen --no-dev --package movie-catalog-mcp

FROM base
WORKDIR /app
RUN addgroup -g 10001 appuser && adduser -D -u 10001 -G appuser appuser
COPY --from=build --chown=10001:10001 /app/.venv /app/.venv
COPY --from=build --chown=10001:10001 /build/apps/movie-catalog-mcp/src /app/src
ENV PATH=/app/.venv/bin:$PATH PYTHONPATH=/app/src PYTHONUNBUFFERED=1 MOVIE_MCP_MODE=http
USER 10001
EXPOSE 8000
CMD ["movie-catalog-mcp"]
