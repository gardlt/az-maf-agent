    "memoryCleanup:Microsoft.App/jobs:0": {
      "type": "Microsoft.App/jobs",
      "apiVersion": "2025-01-01",
      "name": "[parameters('jobName')]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "SystemAssigned, UserAssigned",
        "userAssignedIdentities": {
          "[format('{0}', parameters('pullIdentityId'))]": {}
        }
      },
      "properties": {
        "environmentId": "[parameters('managedEnvironmentId')]",
        "configuration": {
          "triggerType": "Schedule",
          "replicaTimeout": 600,
          "replicaRetryLimit": 1,
          "scheduleTriggerConfig": {
            "cronExpression": "17 * * * *",
            "parallelism": 1,
            "replicaCompletionCount": 1
          },
          "registries": [
            {
              "server": "[parameters('registryLoginServer')]",
              "identity": "[parameters('pullIdentityId')]"
            }
          ]
        },
        "template": {
          "containers": [
            {
              "name": "memory-cleanup",
              "image": "[parameters('image')]",
              "command": [
                "python",
                "-m",
                "az_maf_agent.memory_cleanup"
              ],
              "env": [
                {
                  "name": "SESSION_ACCOUNT",
                  "value": "[parameters('sessionAccountName')]"
                },
                {
                  "name": "SESSION_CONFIG",
                  "value": "/app/config/foundry-stage1.json"
                },
                {
                  "name": "MEMORY_ACCOUNT",
                  "value": "[parameters('memoryAccountName')]"
                },
                {
                  "name": "MEMORY_CONTAINER",
                  "value": "[parameters('memoryContainerName')]"
                },
                {
                  "name": "MEMORY_POLICY",
                  "value": "/app/config/memory-policy.json"
                }
              ],
              "resources": {
                "cpu": "[json('0.25')]",
                "memory": "0.5Gi"
              }
            }
          ]
        }
      }
    },
    "memoryHealth:Microsoft.Insights/scheduledQueryRules:0": {
      "type": "Microsoft.Insights/scheduledQueryRules",
      "apiVersion": "2023-12-01",
      "name": "[parameters('name')]",
      "location": "[parameters('location')]",
      "properties": {
        "displayName": "Memory cleanup has no successful execution in 20 hours",
        "description": "Investigate before the 24-hour expiry cleanup target is breached. No preference contents are queried.",
        "enabled": true,
        "severity": 2,
        "evaluationFrequency": "PT1H",
        "windowSize": "P1D",
        "scopes": [
          "[parameters('workspaceId')]"
        ],
        "autoMitigate": true,
        "criteria": {
          "allOf": [
            {
              "query": "[format('ContainerAppConsoleLogs_CL | where TimeGenerated > ago(20h) | where Log_s has \"memory_cleanup_completed\"{0} | summarize Successes=count() | where Successes == 0', variables('completedFilter'))]",
              "timeAggregation": "Count",
              "operator": "GreaterThan",
              "threshold": 0,
              "failingPeriods": {
                "numberOfEvaluationPeriods": 1,
                "minFailingPeriodsToAlert": 1
              }
            }
          ]
        }
      }
    },
