    "controlStorage:Microsoft.Storage/storageAccounts/managementPolicies:5": {
      "type": "Microsoft.Storage/storageAccounts/managementPolicies",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}/{1}', parameters('accountName'), 'default')]",
      "properties": {
        "policy": {
          "copy": [
            {
              "name": "rules",
              "count": "[length(createArray('guardrail-audit/events/', 'guardrail-policy/approvals/'))]",
              "input": {
                "name": "[format('retire-{0}', split(createArray('guardrail-audit/events/', 'guardrail-policy/approvals/')[copyIndex('rules')], '/')[0])]",
                "enabled": true,
                "type": "Lifecycle",
                "definition": {
                  "filters": {
                    "blobTypes": [
                      "blockBlob"
                    ],
                    "prefixMatch": [
                      "[createArray('guardrail-audit/events/', 'guardrail-policy/approvals/')[copyIndex('rules')]]"
                    ]
                  },
                  "actions": {
                    "baseBlob": {
                      "delete": {
                        "daysAfterModificationGreaterThan": 30
                      }
                    }
                  }
                }
              }
            }
          ]
        }
