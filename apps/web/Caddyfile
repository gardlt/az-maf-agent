{
	admin off
	auto_https off
}

:8080 {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Cache-Control no-store
		-Server
	}
	request_body {
		max_size 1MB
	}
	handle_path /api/* {
		reverse_proxy https://{$AGENT_API_HOST} {
			header_up Host {$AGENT_API_HOST}
			header_up -Cookie
			header_down -Set-Cookie
		}
	}
	handle {
		root * /srv
		file_server
	}
}
